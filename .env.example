# Copy to .env (local runs) or ~/.config/racewatch/env (a server; keeps it out
# of the served folder). Never commit the real file.

# OpenF1 sponsor login - needed for live sessions only; replays work without it.
OPENF1_USERNAME=you@example.com
OPENF1_PASSWORD=

# Optional: URL to POST {"title", "message"} to when live data stops for 60 s
# (e.g. a Home Assistant webhook - see deploy/ha-automation.yaml).
RACEWATCH_ALERT_WEBHOOK=
